#!/usr/bin/env bash
# Runs LICENSED_SETUP and then the given command, by default updating the records, and the NOTICE files when there
# are any, then checking them with licensed status
set -euo pipefail

# The tools run as root, their files go back to the owner of the workspace mounted at /src
owner="$(stat -c %u:%g /src)"
trap 'chown -R "$owner" /src /cache 2>/dev/null || true' EXIT

# Folders an image links into the cache, such as the Android NDK, must exist before the tools write into them
for link in ${LICENSED_CACHE_LINKS:-}; do mkdir -p "$(readlink "$link")"; done

# Evaluated in this shell, so the variables it exports reach the command
eval "${LICENSED_SETUP:-}"

if [ $# -eq 0 ]; then
  licensed cache
  if licensed-notices --enabled; then licensed-notices; fi
  licensed status
else
  "$@"
fi
